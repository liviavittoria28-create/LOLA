{
  "name": "lola",
  "version": "2.0.0",
  "private": true,
  "description": "Lola — plataforma SaaS de agenda, clientes, anamnese, financeiro e estoque para profissionais da beleza (PWA + Postgres/Supabase)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/boot.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server server/boot.js",
    "backups": "node --disable-warning=ExperimentalWarning server/scripts.js backups",
    "restaurar": "node server/scripts.js restaurar",
    "icones": "node scripts/make-icons.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js",
    "prints": "node scripts/tutorial-prints.js",
    "test:postgres": "node --disable-warning=ExperimentalWarning scripts/test-postgres.js",
    "demo": "node scripts/demo-seed.js",
    "site:prints": "node scripts/site-shots.js",
    "site:video": "node scripts/demo-video.js",
    "e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pg": "8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.18"
  }
}
