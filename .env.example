# Copie para .env (uso no computador). Na hospedagem (Render), defina as mesmas variáveis no painel.
PORT=5173

# ---- Painel do proprietário da plataforma (/admin): você, dona da Lola
PLATFORM_EMAIL=seu-email@aqui.com
PLATFORM_PASSWORD=uma-senha-forte-aqui

# ---- Empresa nº 1 (o estúdio original do Agenda Expert). Opcional para novas instalações.
# O acesso desta empresa SEMPRE segue estas variáveis: para trocar e-mail/senha, altere e reinicie.
ADMIN_NAME=Esther Lino
ADMIN_EMAIL=coloque-o-email@aqui.com
ADMIN_PASSWORD=coloque-a-senha-aqui
# Nome da empresa criada pelas variáveis acima numa instalação nova (sem dados antigos)
# ADMIN_COMPANY=Esther Lino Bio Estética

# ---- Banco de dados online (Supabase → Connect → Session pooler). Sem ela, usa um banco local em ./data.
# DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---- Endereço público do site (usado nos links de recuperação de senha por e-mail)
# PUBLIC_URL=https://seudominio.com.br

# ---- E-mail de recuperação de senha (opcional). Sem isso, a recuperação é feita pelo WhatsApp:
# o proprietário gera o link no painel /admin e envia para a cliente.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Lola <nao-responda@seudominio.com.br>
# MAIL_LOG=1   # só no computador: mostra o e-mail no terminal em vez de enviar

# Em produção (HTTPS): NODE_ENV=production
# Desligar o robô do WhatsApp no servidor: WHATSAPP=0
